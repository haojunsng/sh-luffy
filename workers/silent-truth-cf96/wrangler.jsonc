{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "silent-truth-cf96",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-09",
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    {
      "binding": "SUBSCRIPTION_EMAILS",
      "id": "a81033cb661442b49d99306479d6fc7b",
    },
  ],
  "d1_databases": [
    {
      "binding": "MY_D1",
      "database_name": "subscribers-db",
      "database_id": "c74ef0ef-a9a4-49fa-9a26-59ecf685f02e",
    },
  ],
}
